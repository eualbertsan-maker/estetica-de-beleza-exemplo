{
  "color": {
    "forest": { "900": "#141A14", "800": "#1F261D", "950": "#0C100C" },
    "cream": { "100": "#F6EFE6" },
    "sand": { "200": "#EADBC8" },
    "rose": { "100": "#F0DDD8", "500": "#B9807A", "600": "#9C6660", "700": "#8A5750" },
    "gold": { "500": "#B8935A" },
    "lilac": { "300": "#B9A7C6" },
    "sage": { "500": "#6F8467" },
    "white-warm": "#FBF8F3",
    "text": {
      "title": "#1E1E1C",
      "body": "#3A3A3A",
      "muted": "#6B655E",
      "on-dark": "#F6EFE6"
    },
    "border": { "soft": "#DCCDB8", "hover": "#B9A98F", "strong": "#3A3A3A" },
    "state": { "success": "#5F7A5A", "error": "#A5473F", "disabled": "#B9B3A8" }
  },
  "font": {
    "display": "Cormorant Garamond, Playfair Display, Georgia, serif",
    "script": "Pinyon Script, Allura, cursive",
    "body": "Poppins, Jost, system-ui, sans-serif"
  },
  "typography": {
    "h1": { "size": "64px", "weight": 500, "lineHeight": 1.05, "letterSpacing": "-0.02em" },
    "h2": { "size": "44px", "weight": 500, "lineHeight": 1.1, "letterSpacing": "-0.01em" },
    "h3": { "size": "28px", "weight": 600, "lineHeight": 1.2, "letterSpacing": "0" },
    "h4": { "size": "18px", "weight": 500, "lineHeight": 1.4, "letterSpacing": "0" },
    "lead": { "size": "18px", "weight": 300, "lineHeight": 1.7 },
    "body": { "size": "16px", "weight": 400, "lineHeight": 1.7 },
    "small": { "size": "14px", "weight": 400, "lineHeight": 1.6 },
    "label": { "size": "12px", "weight": 500, "lineHeight": 1.4, "letterSpacing": "0.18em", "textTransform": "uppercase" },
    "button": { "size": "13px", "weight": 500, "lineHeight": 1, "letterSpacing": "0.1em", "textTransform": "uppercase" }
  },
  "spacing": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128],
  "radius": { "pill": "999px", "card": "20px", "image": "16px", "input": "14px", "form": "24px" },
  "shadow": {
    "soft": "0 2px 12px rgba(20,26,20,.06)",
    "hover": "0 14px 32px rgba(20,26,20,.12)",
    "button": "0 8px 20px rgba(20,26,20,.18)"
  },
  "layout": { "container": "1200px", "containerWide": "1360px", "gutter": "24px", "sectionY": "96px" },
  "breakpoints": { "mobile": "767px", "tablet": "1023px", "desktop": "1024px" }
}
